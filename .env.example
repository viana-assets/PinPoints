# Supabase-Projekt-URL und Keys (Einstellungen -> API im Supabase-Dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# NUR serverseitig verwenden (API-Routen), NIEMALS ins Frontend/Client-Bundle,
# NIEMALS committen. In Vercel als "Sensitive" Environment Variable setzen.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Hinweis: die frühere Variable ADMIN_EMAIL gibt es nicht mehr. Sie wurde nie ausgewertet –
# der Datenbank-Trigger las current_setting('app.admin_email'), das in einer Supabase-Instanz
# nie gesetzt ist, sodass jeder neue Account ohnehin die Rolle "user" bekam (Review-Befund A8,
# bereinigt in Migration 15). Die Superadmin-Rolle wird bewusst im Admin-Bereich unter
# "Nutzerverwaltung" vergeben.
